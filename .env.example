# Taobao Crawler Agent Configuration

# Agent LLM Settings (OpenAI, Gemini, Anthropic, or DeepSeek)
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Browser / Crawler Settings
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
USER_DATA_DIR=./data/sessions
SLOW_MO_MS=100

# Output Settings
OUTPUT_DIR=./data/outputs
LOG_LEVEL=INFO
